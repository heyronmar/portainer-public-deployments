# Copy to .env for local dev (`npm run dev` reads it). On Kubernetes these are set in k8s/concept-test.yaml.

# Optional public URL for link previews, the canonical URL, robots.txt and sitemap.xml.
# Leave empty to use the domain each visitor came in on (one image can serve several domains).
SITE_URL=

# Where the "Open demo" button sends participants.
DEMO_URL=https://portainer-laptop.heyronmar.com

# HTTP basic auth for the researcher view at /admin. /admin is disabled until both are set.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# SQLite file. In the container this lives on the volume mounted at /data.
# For local dev, point it somewhere writable, e.g. ./data/concept-test.db
DATABASE_PATH=/data/concept-test.db

# Port the app listens on inside the container.
PORT=3000
