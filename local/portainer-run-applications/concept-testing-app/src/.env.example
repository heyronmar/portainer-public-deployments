# Copy to .env (docker compose and `npm run dev` both read it) and fill in.

# Where the "Open demo" button sends participants.
DEMO_URL=https://portainer-laptop.heyronmar.com

# HTTP basic auth for the researcher view at /admin. /admin is disabled until both are set.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# SQLite file. In Docker this lives on the named volume mounted at /data.
# For local dev, point it somewhere writable, e.g. ./data/concept-test.db
DATABASE_PATH=/data/concept-test.db

# Port the app listens on inside the container.
PORT=3000

# docker compose only: host port to publish on.
# HOST_PORT=3000
